# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
APP_NAME=Trend Analyzer
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# ------------------------------------------------------------------
# MySQL (used to build both async + sync SQLAlchemy URLs)
# ------------------------------------------------------------------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=trend
MYSQL_PASSWORD=trend
MYSQL_DATABASE=trend
# Root password is only consumed by the mysql container in docker-compose
MYSQL_ROOT_PASSWORD=root

# ------------------------------------------------------------------
# Redis (cache, locks, rate limiting, live progress, ARQ broker)
# ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------
# Auth (protects write endpoints + dashboard actions)
# Either HTTP Basic (username/password) or a bearer/query API token.
# ------------------------------------------------------------------
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme
API_TOKEN=
# Set true to also require auth on read/dashboard pages
AUTH_PROTECT_READS=false

# ------------------------------------------------------------------
# AI provider (OpenAI). Interface allows adding Claude later.
# ------------------------------------------------------------------
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------
# External data providers
# ------------------------------------------------------------------
TMDB_API_KEY=
OMDB_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=trend-analyzer/0.1 by u/yourname
YOUTUBE_API_KEY=

# ------------------------------------------------------------------
# Sentiment (local HuggingFace model)
# ------------------------------------------------------------------
SENTIMENT_MODEL_NAME=distilbert-base-uncased-finetuned-sst-2-english
# Winning class must clear this softmax probability, else -> neutral
SENTIMENT_NEUTRAL_THRESHOLD=0.65
SENTIMENT_MAX_LENGTH=512
# Where transformers caches downloaded models (mounted volume in compose)
HF_HOME=/models

# ------------------------------------------------------------------
# Discovery / pipeline sizing
# ------------------------------------------------------------------
TRENDING_WINDOW=day
MAX_TITLES=20
TOP_N=10
REVIEWS_PER_TITLE=10
SOCIAL_POSTS_PER_TITLE=25

# ------------------------------------------------------------------
# Ranking weights (relative; re-normalised to sum 1 at runtime)
# ------------------------------------------------------------------
WEIGHT_POPULARITY=0.25
WEIGHT_RATING=0.20
WEIGHT_REVIEW_VOLUME=0.10
WEIGHT_SENTIMENT=0.25
WEIGHT_DISCUSSION_VOLUME=0.10
WEIGHT_ENGAGEMENT=0.10

# ------------------------------------------------------------------
# Caching / rate limiting
# ------------------------------------------------------------------
CACHE_TTL_SECONDS=3600
RATE_LIMIT_PER_SECOND=5
